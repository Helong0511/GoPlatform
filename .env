# ===========================================
# GoPlatform 环境变量配置（详细版）
# 说明：
# 1) 本文件用于覆盖 config/config.yaml 中同名配置。
# 2) 仅填写你需要覆盖的项；不填则使用 YAML 默认值。
# 3) 生产环境请放在服务器私有目录，不要提交到 Git。
# ===========================================

# -------------------------------------------
# 运行环境
# -------------------------------------------
# 可选：development / dev / local / production
# 影响：当 AUTH_ALLOW_PUBLIC_REGISTER 未显式设置时，
#      development/dev/local 默认开放注册，其它默认关闭。
ENVIRONMENT=production

# -------------------------------------------
# 认证开关（可选）
# -------------------------------------------
# 公开注册开关（优先级高于 config.yaml 中 auth.allow_public_register）
# true/false/1/0/yes/no/on/off 都可识别
AUTH_ALLOW_PUBLIC_REGISTER=false

# -------------------------------------------
# 数据库配置（必填项按你的部署填写）
# -------------------------------------------
# 数据库驱动：postgres 或 mysql
DB_DRIVER=postgres
# 数据库地址
DB_HOST=127.0.0.1
DB_PORT=5432
# 数据库账号
DB_USER=postgres
DB_PASSWORD=kb7$rL3d8!tQ
DB_NAME=ad_platform

# -------------------------------------------
# 安全相关（强烈建议生产环境必须设置）
# -------------------------------------------
# JWT 签名密钥（建议 32 字节以上随机串）
JWT_SECRET=NeofZ7iF8tNW6GzkyMZfsGmitY6r6Gwn6D5BU433Vu9lkFwciS2PApBkPMurQuexc9ZgWUjxQA6ZBHMx_bdvHQ
# AES 密钥（Base64 编码；解码后长度需为 16/24/32 字节）
AES_SECRET_KEY=5a7ed770e8fd02c9a10e3c9f8874501231bd3023777b64254fd076785da18f30

# -------------------------------------------
# Redis（可选，仅覆盖密码）
# -------------------------------------------
# 如果 Redis 无密码可留空
REDIS_PASSWORD=

# -------------------------------------------
# 邮件通知（可选）
# -------------------------------------------
# 是否启用邮件（true/false）
EMAIL_ENABLED=true
# SMTP 服务配置（启用邮件时必填）
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=hel290398@gmail.com
EMAIL_PASSWORD=He800407
# 发件人地址；不填时可与 EMAIL_USERNAME 相同
EMAIL_FROM=GoPlatform
